{
  "name": "oliver-ruoss/tc-lib-pdf-wp",
  "description": "WordPress bootstrap for tc-lib-pdf",
  "version": "1.0.0",
  "type": "wordpress-plugin",
  "require": {
    "php": "^8.5",
    "tecnickcom/tc-lib-pdf": "^8.83",
    "tecnickcom/tc-lib-barcode": "^2.17"
  },
  "suggest": {
    "ext-gd": "Fotos in Anhängen drehen und verkleinern (PdfImageNormalizer); ohne gd werden sie unverändert eingebettet",
    "ext-exif": "Ausrichtung von Handyfotos lesen (PdfImageNormalizer)"
  },
	"require-dev": {
    "phpstan/phpstan": "^2.3",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "php-stubs/wordpress-stubs": "^7.1"
  },
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
  "minimum-stability": "stable",
  "prefer-stable": true
}